# Copy to .env.local and fill in. .env.local is git-ignored.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where enquiries are delivered (comma-separate for more than one)
CONTACT_TO_EMAIL=you@example.com

# Sender. Leave unset to use Resend's test sender (onboarding@resend.dev), which only delivers to the
# email you signed up to Resend with. Once you verify your own domain in Resend, set e.g.:
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
